{
  "stan_major_version": "2",
  "stan_minor_version": "18",
  "stan_patch_version": "0",
  "model_name": "icar_model",
  "method": {
    "value": "sample",
    "sample": {
      "num_samples": 1000,
      "num_warmup": 1500,
      "save_warmup": false,
      "thin": 1,
      "adapt": {
        "engaged": true,
        "gamma": 0.05,
        "delta": 0.8,
        "kappa": 0.75,
        "t0": 10,
        "init_buffer": 75,
        "term_buffer": 50,
        "window": 25
      },
      "algorithm": {
        "value": "hmc",
        "hmc": {
          "engine": {
            "value": "nuts",
            "nuts": {
              "max_depth": 12
            }
          },
          "metric": {
            "value": "diag_e"
          },
          "metric_file": "",
          "stepsize": 1,
          "stepsize_jitter": 0
        }
      },
      "num_chains": 1
    }
  },
  "id": 1,
  "data": {
    "file": "icar_nyc.data.R"
  },
  "init": "2",
  "random": {
    "seed": 12345
  },
  "output": {
    "file": "output_icar_nyc-1.csv",
    "diagnostic_file": "",
    "refresh": 10000,
    "sig_figs": -1,
    "profile_file": "profile.csv",
    "save_cmdstan_config": true
  },
  "num_threads": 1
}
